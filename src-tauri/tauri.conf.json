{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOAA",
  "version": "0.1.0",
  "identifier": "br.com.soaa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOAA — Sistema Operacional de Autodidatismo Avançado",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Planejamento inteligente e local de estudos."
  }
}

